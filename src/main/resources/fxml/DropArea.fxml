<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>


<?import java.net.URL?>
<?import javafx.scene.control.Label?>
<TableView xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
           fx:id="dropAreaTable"
           focusTraversable="false"
           styleClass="no-header">
    <stylesheets>
        <URL value="@../css/application.css"/>
    </stylesheets>
    <placeholder>
        <Label text="%drop_area_empty"/>
    </placeholder>
    <columns>
        <TableColumn fx:id="fileNameColumn" prefWidth="100" sortable="false" />
        <TableColumn fx:id="statusColumn" prefWidth="100" sortable="false"/>
    </columns>
</TableView>

